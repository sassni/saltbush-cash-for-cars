---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Stats from '../components/Stats.astro'
import Steps from '../components/Steps.astro'
import Cards from '../components/Cards.astro'
import ServiceCards from '../components/ServiceCards.astro'
import SanityImage from '../components/SanityImage.astro'
import Areas from '../components/Areas.astro'
import Testimonials from '../components/Testimonials.astro'
import Faq from '../components/Faq.astro'
import CtaBand from '../components/CtaBand.astro'
import {getPage, getSettings, getServices} from '../lib/sanity.js'
import {faqSchema, websiteSchema} from '../lib/schema.js'
const p = await getPage('homePage')
const s = await getSettings()
const services = await getServices()
const site = (Astro.site?.toString() || '').replace(/\/$/, '')
---
<Base seo={p.seo} schema={[websiteSchema(s, site), faqSchema(p.faqs)]}>
  <Hero page={p} settings={s} badge={p.heroBadge} />
  <Stats stats={p.stats} />
  <Steps steps={p.steps} heading={p.stepsHeading} intro={p.stepsIntro} dark={false} />

  <section class="section section--alt" aria-labelledby="buy-h">
    <div class="container">
      <div class="split">
        <div>
          <p class="eyebrow">What we buy</p>
          <h2 id="buy-h">{p.buyHeading}</h2>
          <p class="lead" style="color:var(--ink-soft);font-size:var(--fs-lg)">{p.buyIntro}</p>
          <div class="btn-row"><a class="btn" href="#quote">{s.quoteLabel}</a><a class="text-link" style="align-self:center" href="/services/cash-for-cars">How cash for cars works</a></div>
        </div>
        <div class="framed"><SanityImage image={p.buyImage} aspect={4 / 3} widths={[480, 720, 960]} sizes="(min-width: 960px) 560px, calc(100vw - 32px)" /></div>
      </div>
      <div style="margin-top:var(--space-7)"><Cards items={p.buyItems} cols={3} /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-h">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Services</p><h2 id="services-h">{p.servicesHeading}</h2><p>{p.servicesIntro}</p></div>
      <ServiceCards services={services} />
      <p style="margin-top:var(--space-5)"><a class="text-link" href="/services">Compare all our services</a></p>
    </div>
  </section>

  <section class="section section--dark pattern-bg on-dark" aria-labelledby="why-h">
    <div class="container">
      <div class="section-head"><p class="eyebrow">Why Saltbush</p><h2 id="why-h">{p.whyHeading}</h2><p>{p.whyIntro}</p></div>
      <Cards items={p.whyItems} cols={4} />
      <p style="margin-top:var(--space-6)"><a class="btn btn--outline" href="/about">More about our team</a></p>
    </div>
  </section>

  <Testimonials settings={s} />
  <Areas settings={s} />
  <Faq faqs={p.faqs} heading={p.faqHeading} />
  <CtaBand settings={s} />
</Base>
