---
import Base from '../../layouts/Base.astro'
import Hero from '../../components/Hero.astro'
import ContentSections from '../../components/ContentSections.astro'
import Cards from '../../components/Cards.astro'
import Steps from '../../components/Steps.astro'
import Testimonials from '../../components/Testimonials.astro'
import Areas from '../../components/Areas.astro'
import Faq from '../../components/Faq.astro'
import CtaBand from '../../components/CtaBand.astro'
import ServiceCards from '../../components/ServiceCards.astro'
import {getServices, getSettings} from '../../lib/sanity.js'
import {faqSchema, serviceSchema, breadcrumbSchema} from '../../lib/schema.js'

export async function getStaticPaths() {
  const services = await getServices()
  return services.map((sv) => ({params: {slug: sv.slug.current}, props: {sv}}))
}
const {sv} = Astro.props
const s = await getSettings()
const others = (await getServices()).filter((o) => o._id !== sv._id)
const site = (Astro.site?.toString() || '').replace(/\/$/, '')
const crumbs = [{name: s.navHome || 'Home', href: '/'}, {name: s.navServices || 'Services', href: '/services'}, {name: sv.title, href: `/services/${sv.slug.current}`}]
---
<Base seo={sv.seo} schema={[serviceSchema(sv, site), faqSchema(sv.faqs), breadcrumbSchema(crumbs, site)]}>
  <Hero page={sv} settings={s} crumbs={crumbs} />
  <ContentSections sections={sv.sections} />
  {sv.benefits?.length > 0 && (
    <section class="section section--alt" aria-labelledby="benefits-h">
      <div class="container">
        <div class="section-head"><p class="eyebrow">{s.eyebrowBenefits}</p><h2 id="benefits-h">{sv.benefitsHeading}</h2></div>
        <Cards items={sv.benefits} cols={4} />
      </div>
    </section>
  )}
  <Steps steps={sv.steps} heading={sv.stepsHeading} eyebrow={s.eyebrowSteps} />
  <Testimonials settings={s} />
  <Faq faqs={sv.faqs} heading={sv.faqHeading} eyebrow={s.eyebrowFaq} alt />
  <section class="section" aria-labelledby="related-h">
    <div class="container">
      <div class="section-head"><p class="eyebrow">{s.eyebrowRelated}</p><h2 id="related-h">{s.relatedHeading}</h2></div>
      <ServiceCards services={others} settings={s} />
    </div>
  </section>
  <Areas settings={s} />
  <CtaBand settings={s} />
</Base>
