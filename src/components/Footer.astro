---
import Logo from './Logo.astro'
import {telHref} from '../lib/sanity.js'
const {settings: s, services = []} = Astro.props
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <Logo name={s.businessName} />
        <p>{s.footerBlurb}</p>
        <a class="footer-phone" href={telHref(s.phone)}>{s.phone}</a>
      </div>
      <div>
        <h2>{s.footerServicesHeading}</h2>
        <ul>
          <li><a href="/services">{s.footerAllServices}</a></li>
          {services.map((sv) => <li><a href={`/services/${sv.slug.current}`}>{sv.title} Adelaide</a></li>)}
        </ul>
      </div>
      <div>
        <h2>{s.footerCompanyHeading}</h2>
        <ul><li><a href="/">{s.navHome}</a></li><li><a href="/about">{s.footerAboutLink}</a></li><li><a href="/contact">{s.footerContactLink}</a></li></ul>
      </div>
      <div>
        <h2>{s.footerContactHeading}</h2>
        <address style="font-style:normal">
          <ul>
            <li><a href={telHref(s.phone)}>{s.phone}</a></li>
            {s.email && <li><a href={`mailto:${s.email}`}>{s.email}</a></li>}
            <li>{s.street}, {s.suburb} {s.state} {s.postcode}</li>
            {(s.hours || []).map((h) => <li>{h}</li>)}
          </ul>
        </address>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {s.businessName}{s.abn && ` · ABN ${s.abn}`}</span>
      <span>{s.footerTagline}</span>
    </div>
  </div>
</footer>
<div class="callbar" aria-label="Quick contact">
  <a class="btn btn--outline" href={telHref(s.phone)}>{s.mobileCallLabel}</a>
  <a class="btn" href="#quote">{s.headerButton}</a>
</div>
