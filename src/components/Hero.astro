---
import SanityImage from './SanityImage.astro'
import QuoteForm from './QuoteForm.astro'
import Breadcrumbs from './Breadcrumbs.astro'
import Icon from './Icon.astro'
import {telHref} from '../lib/sanity.js'
// Every key page: H1 + CTA buttons above the fold, quote form beside it (desktop) or straight after (mobile).
const {page, settings: s, crumbs, form = true, badge} = Astro.props
---
<section class="hero">
  {page.heroImage?.asset && (
    <div class="hero-bg"><SanityImage image={page.heroImage} priority quality={50} sizes="100vw" widths={[480, 720, 1080, 1600]} /></div>
  )}
  <div class="container hero-inner">
    <div>
      {crumbs && <Breadcrumbs items={crumbs} />}
      {page.heroEyebrow && <p class="eyebrow">{page.heroEyebrow}</p>}
      <h1>{page.heroHeading}</h1>
      {page.heroText && <p class="hero-lead">{page.heroText}</p>}
      {page.heroPoints?.length > 0 && <ul class="ticks">{page.heroPoints.map((p) => <li>{p}</li>)}</ul>}
      {badge && (
        <div class="hero-badges">
          <span class="badge-pill"><span class="dot" aria-hidden="true"></span>{s.heroBadgeLabel} <b class="grad-text">{badge}</b></span>
          <span class="rating"><span class="stars" aria-hidden="true">★★★★★</span> {s.heroRatingText}</span>
        </div>
      )}
      <div class="btn-row">
        <a class="btn" href="#quote">{s.quoteLabel}</a>
        <a class="btn btn--outline" href={telHref(s.phone)}><Icon name="phone" /> {s.callLabel} {s.phone}</a>
      </div>
    </div>
    {form && <QuoteForm settings={s} />}
  </div>
</section>
