---
// Quote form: posts to Web3Forms (emails each lead to the business).
// With JS: submits in-page and shows a success message. Without JS: normal POST + redirect to /thank-you.
const {settings: s, id = 'quote', headingLevel = 'h2'} = Astro.props
const key = import.meta.env.PUBLIC_WEB3FORMS_KEY
const site = Astro.site?.toString().replace(/\/$/, '') || ''
const H = headingLevel
const years = Array.from({length: 46}, (_, i) => new Date().getFullYear() - i)
---
<div class="quote-card" id={id}>
  <H class="h2-like" style="font-size:clamp(1.5rem,1.2rem + 1vw,1.9rem);margin-bottom:.5rem">{s.formHeading}</H>
  <p class="intro">{s.formIntro}</p>
  <form class="quote-form" action="https://api.web3forms.com/submit" method="POST" data-success={s.formSuccess}>
    <input type="hidden" name="access_key" value={key} />
    <input type="hidden" name="subject" value={`New car quote request – ${s.businessName}`} />
    <input type="hidden" name="from_name" value={`${s.businessName} website`} />
    <input type="hidden" name="redirect" value={`${site}/thank-you`} />
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="form-grid">
      <div class="field"><label for={`${id}-name`}>Your name <span class="req" aria-hidden="true">*</span></label><input id={`${id}-name`} name="name" autocomplete="name" required /></div>
      <div class="field"><label for={`${id}-phone`}>Phone <span class="req" aria-hidden="true">*</span></label><input id={`${id}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel" required /></div>
      <div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" /></div>
      <div class="field"><label for={`${id}-suburb`}>Pickup suburb <span class="req" aria-hidden="true">*</span></label><input id={`${id}-suburb`} name="suburb" autocomplete="address-level2" required /></div>
      <div class="field"><label for={`${id}-make`}>Make &amp; model <span class="req" aria-hidden="true">*</span></label><input id={`${id}-make`} name="make_model" placeholder="e.g. Toyota Camry" required /></div>
      <div class="field"><label for={`${id}-year`}>Year</label>
        <select id={`${id}-year`} name="year"><option value="">Select year</option>{years.map((y) => <option>{y}</option>)}<option>Older</option></select>
      </div>
      <div class="field full"><label for={`${id}-cond`}>Condition <span class="req" aria-hidden="true">*</span></label>
        <select id={`${id}-cond`} name="condition" required>
          <option value="">Select condition</option>
          <option>Running and driveable</option><option>Running with problems</option><option>Not running</option>
          <option>Accident / damaged</option><option>Written off</option><option>Scrap / end of life</option><option>Not sure</option>
        </select>
      </div>
      <div class="field full"><label for={`${id}-msg`}>Anything else? (km, damage, rego, keys)</label><textarea id={`${id}-msg`} name="message" rows="3"></textarea></div>
    </div>
    <button class="btn btn--block" type="submit" style="margin-top:14px">{s.formButton}</button>
    <p class="form-note">{s.formReassurance}</p>
    <div class="form-status" role="status" aria-live="polite"></div>
  </form>
</div>
